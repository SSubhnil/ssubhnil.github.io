---
// Build-time SVG of a reasoning trace with sampled continuations from each
// step, in the style of the Monte Carlo rollout plots from my probes paper.
// Deterministic (seeded), so the picture is the same on every build.

const W = 960;
const H = 250;
const STEPS = 14;
const PIT = 9; // first step from which no continuation reaches the answer
const K = 5; // continuations per step

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20261114);

const x0 = 28;
const dx = (W - 150) / (STEPS - 1);
const steps = Array.from({ length: STEPS }, (_, i) => ({
  x: x0 + i * dx,
  y: H / 2 + Math.sin(i * 0.7) * 9 + (rand() - 0.5) * 6,
}));

const tracePath = steps.map((s, i) => `${i ? 'L' : 'M'}${s.x.toFixed(1)} ${s.y.toFixed(1)}`).join(' ');
const goodTrace = steps
  .slice(0, PIT + 1)
  .map((s, i) => `${i ? 'L' : 'M'}${s.x.toFixed(1)} ${s.y.toFixed(1)}`)
  .join(' ');

type Branch = { d: string; ex: number; ey: number; ok: boolean; delay: number };
const branches: Branch[] = [];
steps.slice(0, STEPS - 1).forEach((s, i) => {
  // Chance that a continuation still reaches the answer: falls with depth, zero from the pit on.
  const p = i < PIT ? 0.88 - 0.07 * i : 0;
  for (let k = 0; k < K; k++) {
    const spread = (k - (K - 1) / 2) / ((K - 1) / 2); // -1..1
    const len = 70 + rand() * 70;
    const off = spread * (34 + rand() * 46) + (rand() - 0.5) * 14;
    const ex = Math.min(s.x + len, W - 70);
    const ey = Math.max(10, Math.min(H - 10, s.y + off));
    const c1x = s.x + len * 0.35;
    const c1y = s.y + off * 0.1;
    const c2x = s.x + len * 0.7;
    const c2y = ey;
    branches.push({
      d: `M${s.x.toFixed(1)} ${s.y.toFixed(1)} C${c1x.toFixed(1)} ${c1y.toFixed(1)} ${c2x.toFixed(1)} ${c2y.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`,
      ex,
      ey,
      ok: rand() < p,
      delay: 0.15 + i * 0.09 + k * 0.02,
    });
  }
});

const pit = steps[PIT];
const end = steps[STEPS - 1];
---

<figure class="rollout">
  <div class="frame">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="rt-title">
    <title id="rt-title">
      A reasoning trace with continuations sampled from each step. Early continuations often reach the answer; from
      the marked step on, none do.
    </title>
    <g class="branches">
      {
        branches.map((b) => (
          <g class:list={[b.ok ? 'ok' : 'fail']} style={`--d:${b.delay.toFixed(2)}s`}>
            <path d={b.d} pathLength="1" />
            <circle cx={b.ex.toFixed(1)} cy={b.ey.toFixed(1)} r="2.4" />
          </g>
        ))
      }
    </g>
    <path class="trace bad" d={tracePath} />
    <path class="trace good" d={goodTrace} />
    {steps.map((s, i) => <circle class:list={['node', i >= PIT && 'after']} cx={s.x} cy={s.y} r="3.2" />)}
    <circle class="pit-ring" cx={pit.x} cy={pit.y} r="9" />
    <text class="label" x={pit.x} y={pit.y + 30} text-anchor="middle">fails here</text>
    <text class="label" x={end.x + 16} y={end.y + 4.5}>wrong answer</text>
  </svg>
  </div>
  <figcaption>
    A reasoning trace (bold line) with continuations sampled from each step. Teal continuations still reach the
    correct answer; from the amber step on, none do. My <a href="/research/#probes">probes paper</a> tries to locate
    that step.
  </figcaption>
</figure>

<style>
  .rollout {
    margin: 0 0 2.6rem;
  }
  .frame {
    overflow: hidden;
  }
  svg {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .branches path {
    fill: none;
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.7s ease-out forwards;
    animation-delay: var(--d);
  }
  .branches circle {
    opacity: 0;
    animation: appear 0.3s ease-out forwards;
    animation-delay: calc(var(--d) + 0.55s);
  }
  .ok path {
    stroke: var(--teal);
    stroke-opacity: 0.55;
  }
  .ok circle {
    fill: var(--teal);
  }
  .fail path {
    stroke: var(--muted);
    stroke-opacity: 0.3;
  }
  .fail circle {
    fill: var(--muted);
    fill-opacity: 0.5;
  }
  .trace {
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trace.bad {
    stroke: var(--amber);
  }
  .trace.good {
    stroke: var(--text);
  }
  .node {
    fill: var(--bg);
    stroke: var(--text);
    stroke-width: 1.6;
  }
  .node.after {
    stroke: var(--amber);
  }
  .pit-ring {
    fill: none;
    stroke: var(--amber);
    stroke-width: 1.4;
  }
  .label {
    font-family: var(--font-sans);
    font-size: 13px;
    fill: var(--muted);
  }
  figcaption {
    max-width: var(--measure);
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .branches path {
      stroke-dashoffset: 0;
    }
    .branches circle {
      opacity: 1;
    }
  }
  @media (max-width: 640px) {
    /* Crop to the middle of the tree so it stays legible on a phone. */
    svg {
      width: 175%;
      max-width: none;
      margin-left: -42%;
    }
    .label {
      font-size: 17px;
    }
  }
</style>
