---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, updated, tags, draft } = post.data;
---

<Base title={title} description={description} noindex={draft}>
  <article class="prose post">
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>, updated {formatDate(updated)}</span>}
        {draft && <span class="draft">Draft</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )
      }
    </header>
    <Content />
    <footer>
      <a href="/blog/">All posts</a>
    </footer>
  </article>
</Base>

<style>
  .post {
    padding-top: 3rem;
  }
  header {
    margin-bottom: 2.4rem;
  }
  h1 {
    margin-bottom: 0.6rem;
  }
  .meta {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0;
  }
  .draft {
    margin-left: 0.7rem;
    color: var(--amber);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0.7rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }
  .tags li {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
    color: var(--muted);
  }
  .post :global(h2) {
    margin-top: 2.2em;
  }
  .post :global(li) {
    margin-bottom: 0.35em;
  }
  footer {
    margin-top: 3.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.92rem;
  }
</style>
